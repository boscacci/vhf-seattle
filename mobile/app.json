{
  "expo": {
    "name": "Elliott Bay VHF",
    "slug": "elliott-bay-vhf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "elliottbayvhf",
    "backgroundColor": "#041411",
    "ios": {
      "bundleIdentifier": "com.robertboscacci.elliottbayvhf",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Elliott Bay VHF needs location access to display GPS elevation."
      }
    },
    "android": {
      "package": "com.robertboscacci.elliottbayvhf",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "HIGH_SAMPLING_RATE_SENSORS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#041411",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-location"
    ]
  }
}
