# Private API auth. Use a long random ingest token and keep it out of git.
TALKINGBOATS_INGEST_TOKEN=replace-with-private-pi-ingest-token

# AWS/S3.
TALKINGBOATS_AWS_REGION=us-west-2
TALKINGBOATS_RAW_BUCKET=talkingboats-raw-audio-example
TALKINGBOATS_PUBLIC_BUCKET=talkingboats-public-site-example
TALKINGBOATS_RAW_PRESIGN_SECONDS=900
TALKINGBOATS_PLAYBACK_PRESIGN_SECONDS=300
TALKINGBOATS_CLIP_DB_PATH=/home/rob/.local/share/talkingboats/live-transcripts.sqlite3

# Public export defaults.
TALKINGBOATS_PUBLIC_SITE_DIR=outputs/public-site
TALKINGBOATS_PUBLIC_BASE_URL=https://vhf.robertboscacci.com

# Private live-radio upstreams. Keep these on LAN/Tailscale/private network.
TALKINGBOATS_LIVE_68_URL=http://127.0.0.1:8040/vhf-68.mp3
TALKINGBOATS_LIVE_14_URL=http://127.0.0.1:8040/vhf-14.mp3
TALKINGBOATS_LIVE_16_URL=http://127.0.0.1:8040/vhf-16.mp3
