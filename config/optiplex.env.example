TALKINGBOATS_AWS_REGION=us-west-2
TALKINGBOATS_RAW_BUCKET=
TALKINGBOATS_CLIP_STORE_BACKEND=dynamodb
TALKINGBOATS_TRANSCRIPT_STORE_BACKEND=dynamodb
TALKINGBOATS_DURABLE_EVENTS_TABLE=
TALKINGBOATS_DURABLE_EVENTS_ENVIRONMENT=dev
TALKINGBOATS_DURABLE_EVENTS_REQUIRED=true
TALKINGBOATS_INGEST_TOKEN=
TALKINGBOATS_LAN_INTERFACE=eth0
TALKINGBOATS_LAN_NETWORK=192.168.1.0/24
TALKINGBOATS_MDNS_HOSTNAME=optiplex.local
TALKINGBOATS_MDNS_INTERFACE=eth0
TALKINGBOATS_PRIVATE_API=http://private-api:8034
TALKINGBOATS_PROXY_PRIVATE_API_URL=http://private-api:8034
TALKINGBOATS_PROXY_CLIP_SEARCH_READ_TIMEOUT_SECONDS=25
TALKINGBOATS_PROXY_STREAM_URL=http://192.168.1.114:8000/talkingboats-live.mp3
TALKINGBOATS_PROXY_STREAM_URLS=http://192.168.1.114:8000/talkingboats-live.mp3,http://192.168.1.114:8000/talkingboats-14.mp3
TALKINGBOATS_PROXY_CHANNEL_STREAM_URLS=14=http://192.168.1.114:8000/talkingboats-live.mp3;13=http://192.168.1.114:8000/talkingboats-13.mp3;16=http://192.168.1.114:8000/talkingboats-16.mp3;66A=http://192.168.1.114:8000/talkingboats-66a.mp3;78A=http://192.168.1.114:8000/talkingboats-78a.mp3;71=http://192.168.1.114:8000/talkingboats-71.mp3
TALKINGBOATS_PROXY_AIS_CATCHER_BASE_URL=http://192.168.1.114:8100
TALKINGBOATS_PROXY_RETUNE_SSH_TARGET=192.168.1.114
TALKINGBOATS_PROXY_RESTART_TRANSCRIBER=false
TALKINGBOATS_TRANSCRIBE_STREAM_URL=http://192.168.1.114:8000/talkingboats-live.mp3
TALKINGBOATS_TRANSCRIBE_MODEL=large-v3-turbo
TALKINGBOATS_TRANSCRIBE_DEVICE=cpu
TALKINGBOATS_TRANSCRIBE_COMPUTE_TYPE=int8
TALKINGBOATS_TRANSCRIBE_CPU_THREADS=2
TALKINGBOATS_TRANSCRIBE_WORKERS=1
TALKINGBOATS_TRANSCRIBE_WAITING_UPLOAD_MAX_AGE_SECONDS=3600
TALKINGBOATS_TRANSCRIBE_BEAM_SIZE=5
TALKINGBOATS_TRANSCRIBE_HOTWORDS=Seattle Traffic, Elliott Bay, VTS, bridge to bridge, roger

# Operator credential belongs only in a private, mode-0600 runtime env file.
TALKINGBOATS_ASR_FEEDBACK_ENABLED=false
TALKINGBOATS_ENFORCE_ACTIVE_CHANNELS=true
