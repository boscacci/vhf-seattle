{
  "ignores": [
    "infra/opentofu/.terraform/**",
    "node_modules/**"
  ],
  "config": {
    "default": true,
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false
    },
    "MD033": {
      "allowed_elements": [
        "a",
        "em",
        "h1",
        "img",
        "p",
        "strong"
      ]
    }
  }
}
