[Unit]
Description=Talking Boats live caption transcriber
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/rob/repos/elliott-bay-vhf
EnvironmentFile=-/home/rob/repos/elliott-bay-vhf/.env
Environment=TALKINGBOATS_TRANSCRIPT_STORE_BACKEND=dynamodb
ExecStart=/home/rob/miniforge3/condabin/conda run --no-capture-output -n dell talkingboats-live-transcriber --stream-url http://192.168.1.114:8000/talkingboats-live.mp3 --host 0.0.0.0 --port 8055
Restart=always
RestartSec=20
Nice=10
CPUWeight=25
CPUQuota=125%
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
