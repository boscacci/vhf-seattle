[Unit]
Description=Talking Boats private API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/repos/elliott-bay-vhf/.runtime/live-ais-deploy
EnvironmentFile=%h/repos/elliott-bay-vhf/.runtime/live-ais-deploy/.env
ExecStartPre=/bin/bash %h/repos/elliott-bay-vhf/.runtime/live-ais-deploy/scripts/talkingboats_lan_address.sh
ExecStart=/bin/bash -lc 'bind_host="$$(/bin/bash %h/repos/elliott-bay-vhf/.runtime/live-ais-deploy/scripts/talkingboats_lan_address.sh)"; exec /home/rob/miniforge3/condabin/conda run --no-capture-output -n dell uvicorn talkingboats.api:app --host "$${bind_host}" --port 8034'
ExecStartPost=%h/repos/elliott-bay-vhf/.runtime/live-ais-deploy/scripts/talkingboats_warm_search.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
