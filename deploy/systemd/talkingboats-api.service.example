[Unit]
Description=Talking Boats private API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/rob/repos/elliott-bay-vhf-live-ais-deploy
EnvironmentFile=/home/rob/repos/elliott-bay-vhf-live-ais-deploy/.env
ExecStartPre=/bin/bash /home/rob/repos/elliott-bay-vhf-live-ais-deploy/scripts/talkingboats_lan_address.sh
ExecStart=/bin/bash -lc 'bind_host="$$(/bin/bash /home/rob/repos/elliott-bay-vhf-live-ais-deploy/scripts/talkingboats_lan_address.sh)"; exec /home/rob/miniforge3/condabin/conda run --no-capture-output -n dell uvicorn talkingboats.api:app --host "$${bind_host}" --port 8034 --workers 2'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
