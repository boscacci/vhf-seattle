[Unit]
Description=Talking Boats private API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/rob/repos/elliott-bay-vhf-live-ais-deploy
EnvironmentFile=/home/rob/repos/elliott-bay-vhf-live-ais-deploy/.env
ExecStartPre=/home/rob/miniforge3/condabin/conda run --no-capture-output -n dell python -m talkingboats.network_readiness --lan-address 192.168.1.247/24
ExecStart=/home/rob/miniforge3/condabin/conda run -n dell uvicorn talkingboats.api:app --host 192.168.1.247 --port 8034
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
