[Unit]
Description=Refresh Elliott Bay VHF public clips
After=network-online.target talkingboats-api.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/home/rob/repos/elliott-bay-vhf-live-ais-deploy
EnvironmentFile=-/home/rob/repos/elliott-bay-vhf-live-ais-deploy/.env
ExecStartPre=/bin/bash /home/rob/repos/elliott-bay-vhf-live-ais-deploy/scripts/talkingboats_lan_address.sh --dns-host dynamodb.us-west-2.amazonaws.com
ExecStart=/home/rob/repos/elliott-bay-vhf-live-ais-deploy/scripts/refresh_public_clips.sh
Restart=on-failure
RestartSec=2min
TimeoutStartSec=20min
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=75%
CPUWeight=10
