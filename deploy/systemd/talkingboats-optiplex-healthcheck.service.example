[Unit]
Description=Verify and recover Talking Boats OptiPlex services
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=%h/repos/elliott-bay-vhf/.runtime/live-ais-deploy
ExecStart=%h/repos/elliott-bay-vhf/.runtime/live-ais-deploy/scripts/talkingboats_optiplex_healthcheck.sh
TimeoutStartSec=2min
