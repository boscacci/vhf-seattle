[Unit]
Description=Talking Boats uploaded clip transcriber
After=network-online.target talkingboats-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rob/repos/elliott-bay-vhf-live-ais-deploy
EnvironmentFile=/home/rob/.config/talkingboats/api.env
EnvironmentFile=-/home/rob/repos/elliott-bay-vhf-live-ais-deploy/outputs/asr-feedback/latest_model.env
Environment=TALKINGBOATS_TRANSCRIBE_TRUST_EDGE_PREPROCESSED_AUDIO=true
ExecStart=/home/rob/miniforge3/condabin/conda run --no-capture-output -n dell talkingboats-transcribe-uploaded-clips --poll-seconds 30 --limit 5
Restart=always
RestartSec=10
Nice=10
CPUWeight=25
CPUQuota=125%
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
