[Unit]
Description=Talking Boats uploaded clip transcriber
After=network-online.target talkingboats-api.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/repos/elliott-bay-vhf/.runtime/live-ais-deploy
EnvironmentFile=/home/rob/.config/talkingboats/api.env
Environment=TALKINGBOATS_TRANSCRIBE_MODEL=turbo
Environment=TALKINGBOATS_TRANSCRIBE_DEVICE=cpu
Environment=TALKINGBOATS_TRANSCRIBE_COMPUTE_TYPE=int8
Environment=TALKINGBOATS_TRANSCRIBE_CPU_THREADS=2
Environment=TALKINGBOATS_TRANSCRIBE_WORKERS=1
ExecStartPre=/bin/bash %h/repos/elliott-bay-vhf/.runtime/live-ais-deploy/scripts/talkingboats_lan_address.sh --dns-host dynamodb.us-west-2.amazonaws.com
ExecStart=/home/rob/miniforge3/condabin/conda run --no-capture-output -n dell talkingboats-transcribe-uploaded-clips --poll-seconds 30 --limit 5
Restart=always
RestartSec=10
Nice=10
CPUWeight=25
CPUQuota=200%
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
