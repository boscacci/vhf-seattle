[Unit]
Description=Elliott Bay VHF lexical analysis refresh
After=network-online.target talkingboats-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/rob/repos/elliott-bay-vhf-live-ais-deploy
EnvironmentFile=-/home/rob/repos/elliott-bay-vhf-live-ais-deploy/.env
ExecStart=/home/rob/repos/elliott-bay-vhf-live-ais-deploy/scripts/refresh_lexical_analysis.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=150%
CPUWeight=20
