[Unit]
Description=Elliott Bay VHF lexical analysis refresh
After=network-online.target talkingboats-api.service
Wants=network-online.target
StartLimitIntervalSec=6h
StartLimitBurst=2

[Service]
Type=oneshot
WorkingDirectory=%h/repos/elliott-bay-vhf/.runtime/live-ais-deploy
EnvironmentFile=-%h/repos/elliott-bay-vhf/.runtime/live-ais-deploy/.env
ExecStartPre=/bin/bash %h/repos/elliott-bay-vhf/.runtime/live-ais-deploy/scripts/talkingboats_lan_address.sh --dns-host dynamodb.us-west-2.amazonaws.com
ExecStart=%h/repos/elliott-bay-vhf/.runtime/live-ais-deploy/scripts/refresh_lexical_analysis.sh
Restart=on-failure
RestartSec=15min
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=150%
CPUWeight=20
