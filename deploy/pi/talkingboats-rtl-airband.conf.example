# Starter config sketch for RTLSDR-Airband.
# Fill in device serials after running: rtl_test
#
# Keep Icecast/private stream endpoints on LAN or Tailscale only.

devices:
({
  type = "rtlsdr";
  index = 0;
  gain = 28;
  correction = 0;
  mode = "multichannel";
  centerfreq = 156675000;
  channels:
  (
    {
      freq = 156650000;
      modulation = "nfm";
      label = "vhf-13";
      outputs:
      (
        {
          type = "rawfile";
          directory = "/opt/talkingboats/spool/airband/13";
          filename_template = "vhf-13";
          split_on_transmission = true;
        }
      );
    },
    {
      freq = 156700000;
      modulation = "nfm";
      label = "vhf-14";
      outputs:
      (
        {
          type = "rawfile";
          directory = "/opt/talkingboats/spool/airband/14";
          filename_template = "vhf-14";
          split_on_transmission = true;
        }
      );
    }
  );
});
