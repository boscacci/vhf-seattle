#!/usr/bin/env bash
set -euo pipefail

probe_timeout_seconds="${TALKINGBOATS_PI_HEALTHCHECK_TIMEOUT_SECONDS:-5}"
probe_attempts="${TALKINGBOATS_PI_HEALTHCHECK_ATTEMPTS:-2}"
restart_wait_seconds="${TALKINGBOATS_PI_HEALTHCHECK_RESTART_WAIT_SECONDS:-3}"
capture_service="talkingboats-profile-capture.service"
icecast_status_url="${TALKINGBOATS_PI_ICECAST_STATUS_URL:-http://127.0.0.1:8000/status-json.xsl}"
icecast_expected_mount="${TALKINGBOATS_PI_ICECAST_EXPECTED_MOUNT:-/talkingboats-live.mp3}"
icecast_source_probe_attempts="${TALKINGBOATS_PI_ICECAST_SOURCE_PROBE_ATTEMPTS:-2}"
icecast_source_recovery_attempts="${TALKINGBOATS_PI_ICECAST_SOURCE_RECOVERY_ATTEMPTS:-20}"
spool_root="${TALKINGBOATS_PI_SPOOL_ROOT:-/opt/talkingboats/spool/airband}"
spool_flood_window_minutes="${TALKINGBOATS_PI_SPOOL_FLOOD_WINDOW_MINUTES:-2}"
spool_flood_max_files="${TALKINGBOATS_PI_SPOOL_FLOOD_MAX_FILES:-240}"
spool_flood_cooldown_minutes="${TALKINGBOATS_PI_SPOOL_FLOOD_COOLDOWN_MINUTES:-5}"
spool_flood_marker="${TALKINGBOATS_PI_SPOOL_FLOOD_MARKER:-/run/talkingboats/spool-flood-restarted}"

log_event() {
  local event="$1"
  local service="$2"
  local detail="$3"
  printf 'event=%s service=%s detail=%s\n' "${event}" "${service}" "${detail}"
}

ensure_active() {
  local service="$1"
  if systemctl is-active --quiet "${service}"; then
    return 0
  fi
  log_event "talkingboats_pi_health_restart" "${service}" "inactive"
  systemctl reset-failed "${service}" >/dev/null 2>&1 || true
  systemctl restart "${service}"
  sleep "${restart_wait_seconds}"
  if systemctl is-active --quiet "${service}"; then
    return 0
  fi
  log_event "talkingboats_pi_health_failed" "${service}" "still_inactive"
  return 1
}

positive_integer() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

recent_completed_clip_count() {
  find "${spool_root}" \
    -type f \
    -name "*.mp3" \
    -mmin "-${spool_flood_window_minutes}" \
    -printf "%p\n" 2>/dev/null |
    wc -l |
    tr -d "[:space:]"
}

spool_flood_recovery_cooldown() {
  [[ -f "${spool_flood_marker}" ]] &&
    find "${spool_flood_marker}" \
      -mmin "-${spool_flood_cooldown_minutes}" \
      -print \
      -quit 2>/dev/null |
      grep -q .
}

ensure_capture_rate_healthy() {
  local recent_clip_count
  local detail

  ensure_active "${capture_service}" || return 1
  if ! positive_integer "${spool_flood_window_minutes}" ||
    ! positive_integer "${spool_flood_max_files}" ||
    ! positive_integer "${spool_flood_cooldown_minutes}"; then
    log_event "talkingboats_pi_health_failed" "${capture_service}" \
      "invalid_spool_flood_threshold"
    return 1
  fi
  if [[ ! -d "${spool_root}" ]]; then
    log_event "talkingboats_pi_health_failed" "${capture_service}" "spool_root_missing"
    return 1
  fi
  if spool_flood_recovery_cooldown; then
    log_event "talkingboats_pi_health_ok" "${capture_service}" \
      "spool_flood_recovery_cooldown"
    return 0
  fi

  recent_clip_count="$(recent_completed_clip_count)"
  if [[ "${recent_clip_count}" -le "${spool_flood_max_files}" ]]; then
    return 0
  fi

  detail="spool_flood_${recent_clip_count}_files_in_${spool_flood_window_minutes}m"
  log_event "talkingboats_pi_health_restart" "${capture_service}" "${detail}"
  systemctl restart "${capture_service}"
  sleep "${restart_wait_seconds}"
  if ! systemctl is-active --quiet "${capture_service}"; then
    log_event "talkingboats_pi_health_failed" "${capture_service}" \
      "spool_flood_restart_failed"
    return 1
  fi
  install -d -m 0755 "$(dirname "${spool_flood_marker}")"
  touch "${spool_flood_marker}"
  log_event "talkingboats_pi_health_recovered" "${capture_service}" "${detail}"
}

probe_url() {
  local url="$1"
  local attempt
  for attempt in $(seq 1 "${probe_attempts}"); do
    if curl --fail --silent --show-error --max-time "${probe_timeout_seconds}" "${url}" >/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}

private_api_url() {
  local env_file="${TALKINGBOATS_PI_ENV_FILE:-/etc/talkingboats/live-radio.env}"
  local private_api

  if [[ ! -r "${env_file}" ]]; then
    return 1
  fi

  private_api="$(sed -n -E 's/^[[:space:]]*TALKINGBOATS_PRIVATE_API=(.*)$/\1/p' "${env_file}" | tail -n 1)"
  private_api="${private_api%$'\r'}"
  case "${private_api}" in
    \"*\") private_api="${private_api:1:${#private_api}-2}" ;;
    \'*\') private_api="${private_api:1:${#private_api}-2}" ;;
  esac
  [[ "${private_api}" =~ ^https?:// ]] || return 1
  printf '%s\n' "${private_api%/}"
}

env_value() {
  local requested_key="$1"
  local env_file="${TALKINGBOATS_PI_ENV_FILE:-/etc/talkingboats/live-radio.env}"
  local key
  local value
  local matched_value=""

  [[ -r "${env_file}" ]] || return 1
  while IFS="=" read -r key value; do
    if [[ "${key}" == "${requested_key}" ]]; then
      matched_value="${value}"
    fi
  done < "${env_file}"
  matched_value="${matched_value%$'\r'}"
  case "${matched_value}" in
    \"*\") matched_value="${matched_value:1:${#matched_value}-2}" ;;
    \'*\') matched_value="${matched_value:1:${#matched_value}-2}" ;;
  esac
  printf '%s' "${matched_value}"
}

ais_forwarder_configured() {
  local ingest_url
  local ingest_token

  ingest_url="$(env_value TALKINGBOATS_AIS_HTTP_INGEST_URL)"
  ingest_token="$(env_value TALKINGBOATS_AIS_INGEST_TOKEN)"
  [[ -n "${ingest_url}" && -n "${ingest_token}" ]]
}

ensure_private_api_reachable() {
  local private_api
  if ! private_api="$(private_api_url)"; then
    log_event "talkingboats_pi_health_failed" "private_api" "private_api_missing_or_invalid"
    return 1
  fi

  if probe_url "${private_api}/healthz"; then
    return 0
  fi

  # The uploader owns retrying uploads.  Do not restart it just because the
  # upstream endpoint is unavailable; the timer provides bounded observability.
  log_event "talkingboats_pi_health_failed" "private_api" "private_api_unreachable"
  return 1
}

ensure_http_service() {
  local service="$1"
  local url="$2"
  ensure_active "${service}"
  if probe_url "${url}"; then
    return 0
  fi
  log_event "talkingboats_pi_health_restart" "${service}" "probe_failed"
  systemctl restart "${service}"
  sleep "${restart_wait_seconds}"
  if probe_url "${url}"; then
    return 0
  fi
  log_event "talkingboats_pi_health_failed" "${service}" "probe_failed_after_restart"
  return 1
}

icecast_capture_source_present() {
  local attempt
  for attempt in $(seq 1 "${icecast_source_probe_attempts}"); do
    if curl --fail --silent --show-error --max-time "${probe_timeout_seconds}" \
      "${icecast_status_url}" |
      python3 -c '
import json
import sys
from urllib.parse import urlparse

expected_mount = sys.argv[1]
try:
    payload = json.load(sys.stdin)
except (json.JSONDecodeError, AttributeError):
    raise SystemExit(1) from None
sources = payload.get("icestats", {}).get("source", [])
if isinstance(sources, dict):
    sources = [sources]
mounts = {
    urlparse(str(source.get("listenurl", ""))).path
    for source in sources
    if isinstance(source, dict)
}
raise SystemExit(0 if expected_mount in mounts else 1)
' "${icecast_expected_mount}"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

ensure_icecast_capture_source() {
  local attempt

  if ! positive_integer "${icecast_source_probe_attempts}" ||
    ! positive_integer "${icecast_source_recovery_attempts}"; then
    log_event "talkingboats_pi_health_failed" "${capture_service}" \
      "invalid_icecast_source_attempts"
    return 1
  fi
  if icecast_capture_source_present; then
    return 0
  fi

  log_event "talkingboats_pi_health_restart" "${capture_service}" \
    "icecast_source_missing"
  systemctl restart "${capture_service}"
  for attempt in $(seq 1 "${icecast_source_recovery_attempts}"); do
    sleep 1
    if systemctl is-active --quiet "${capture_service}" &&
      icecast_capture_source_present; then
      log_event "talkingboats_pi_health_recovered" "${capture_service}" \
        "icecast_source_recovered"
      return 0
    fi
  done

  log_event "talkingboats_pi_health_failed" "${capture_service}" \
    "icecast_source_missing_after_restart"
  return 1
}

failures=0
icecast_http_healthy=false

ensure_active "talkingboats-spool-uploader.service" || failures=$((failures + 1))
ensure_private_api_reachable || failures=$((failures + 1))
ensure_http_service "talkingboats-ais-catcher.service" \
  "http://127.0.0.1:8100/api/stat.json?receiver=" || failures=$((failures + 1))
if ais_forwarder_configured; then
  ensure_active "talkingboats-ais-forwarder.service" || failures=$((failures + 1))
fi
if ensure_http_service "icecast2.service" "${icecast_status_url}"; then
  icecast_http_healthy=true
else
  failures=$((failures + 1))
fi
ensure_capture_rate_healthy || failures=$((failures + 1))
if [[ "${icecast_http_healthy}" == "true" ]]; then
  ensure_icecast_capture_source || failures=$((failures + 1))
fi
ensure_http_service "talkingboats-live-radio-web.service" \
  "http://127.0.0.1:8050/current-status.json" || failures=$((failures + 1))

if [[ "${failures}" -gt 0 ]]; then
  log_event "talkingboats_pi_health_degraded" "station" "failures_${failures}"
  exit 1
fi
log_event "talkingboats_pi_health_ok" "station" "all_checks_passed"
