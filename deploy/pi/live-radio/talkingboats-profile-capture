#!/usr/bin/env bash
set -euo pipefail

profile="${TALKINGBOATS_CAPTURE_PROFILE:-debug}"
airband_binary="${TALKINGBOATS_AIRBAND_BINARY:-/usr/local/bin/rtl_airband}"
airband_config_dir="${TALKINGBOATS_AIRBAND_CONFIG_DIR:-/etc/talkingboats}"
slot_cooldown_seconds="${TALKINGBOATS_CAPTURE_SLOT_COOLDOWN_SECONDS:-5}"
status_path="${TALKINGBOATS_CAPTURE_STATUS_PATH:-/opt/talkingboats/live-radio/current-status.json}"

write_slot_status() {
  local channel="$1"
  local frequency_hz="$2"
  local label="$3"

  python3 - "${status_path}" "${profile}" "${channel}" "${frequency_hz}" "${label}" <<'PY'
from __future__ import annotations

import json
import sys
from datetime import UTC, datetime
from pathlib import Path

path = Path(sys.argv[1])
payload = {
    "profile": sys.argv[2],
    "channel": sys.argv[3],
    "frequencyHz": int(sys.argv[4]),
    "label": sys.argv[5],
    "updatedAt": datetime.now(UTC).isoformat().replace("+00:00", "Z"),
}
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(payload, sort_keys=True) + "\n", encoding="utf-8")
PY
}

run_sequential_slot() {
  local channel="$1"
  local frequency_hz="$2"
  local label="$3"
  local seconds="$4"
  local threshold_rms="$5"
  local min_clip_seconds="$6"
  local post_roll_seconds="$7"
  local max_clip_seconds="$8"

  echo "event=capture_profile_slot_start profile=${profile} channel=${channel} frequency_hz=${frequency_hz} seconds=${seconds}" >&2
  write_slot_status "${channel}" "${frequency_hz}" "${label}"
  set +e
  TALKINGBOATS_LIVE_CHANNEL="${channel}" \
    TALKINGBOATS_LIVE_FREQUENCY_HZ="${frequency_hz}" \
    TALKINGBOATS_LIVE_LABEL="${label}" \
    TALKINGBOATS_ICECAST_MOUNT="${TALKINGBOATS_CAPTURE_LIVE_MOUNT:-/talkingboats-live.mp3}" \
    TALKINGBOATS_EDGE_THRESHOLD_RMS="${threshold_rms}" \
    TALKINGBOATS_EDGE_MIN_CLIP_SECONDS="${min_clip_seconds}" \
    TALKINGBOATS_EDGE_POST_ROLL_SECONDS="${post_roll_seconds}" \
    TALKINGBOATS_EDGE_MAX_CLIP_SECONDS="${max_clip_seconds}" \
    timeout --kill-after=10s "${seconds}s" \
      /opt/talkingboats/bin/talkingboats-edge-live-radio-stream
  local status="$?"
  set -e
  case "${status}" in
    0|124|137|143)
      ;;
    *)
      echo "event=capture_profile_slot_failed profile=${profile} channel=${channel} status=${status}" >&2
      ;;
  esac
  sleep "${slot_cooldown_seconds}"
}

run_debug_profile() {
  local vts_seconds="${TALKINGBOATS_CAPTURE_DEBUG_14_SECONDS:-180}"
  local vts_threshold="${TALKINGBOATS_CAPTURE_DEBUG_14_THRESHOLD_RMS:-5000}"
  local vts_min_clip_seconds="${TALKINGBOATS_CAPTURE_DEBUG_14_MIN_CLIP_SECONDS:-2.0}"
  local vts_post_roll_seconds="${TALKINGBOATS_CAPTURE_DEBUG_14_POST_ROLL_SECONDS:-0.4}"
  local vts_max_clip_seconds="${TALKINGBOATS_CAPTURE_DEBUG_14_MAX_CLIP_SECONDS:-30}"

  while true; do
    run_sequential_slot \
      "14" \
      "156700000" \
      "VTS / Seattle Traffic" \
      "${vts_seconds}" \
      "${vts_threshold}" \
      "${vts_min_clip_seconds}" \
      "${vts_post_roll_seconds}" \
      "${vts_max_clip_seconds}"
  done
}

run_elliott_bay_profile() {
  local config_path="${airband_config_dir}/rtl_airband-elliott-bay.conf"
  if [[ ! -x "${airband_binary}" ]]; then
    echo "RTLSDR-Airband is not installed or executable: ${airband_binary}" >&2
    echo "Run scripts/install_rtlsdr_airband_pi.sh on the Pi, then restart this service." >&2
    exit 127
  fi
  if [[ ! -r "${config_path}" ]]; then
    echo "RTLSDR-Airband config is not readable: ${config_path}" >&2
    exit 2
  fi
  echo "event=capture_profile_airband_start profile=${profile} config=${config_path}" >&2
  exec "${airband_binary}" -F -e -c "${config_path}"
}

case "${profile}" in
  debug)
    run_debug_profile
    ;;
  elliott_bay)
    run_elliott_bay_profile
    ;;
  *)
    echo "Unsupported TALKINGBOATS_CAPTURE_PROFILE: ${profile}" >&2
    exit 2
    ;;
esac
