TALKINGBOATS_PRIVATE_API=http://optiplex.local:8034
TALKINGBOATS_INGEST_TOKEN=replace-with-private-pi-ingest-token

# Used by talkingboats-upload-clip when a capture loop hands it a completed file.
# The uploader keeps AWS credentials off the Pi by requesting short-lived upload
# URLs from the private API.
TALKINGBOATS_VOICE_DEVICE_INDEX=0
TALKINGBOATS_VOICE_SDR_SERIAL=replace-after-rtl-test
TALKINGBOATS_AIS_INPUT=auto
TALKINGBOATS_AIS_SERIAL_PORT=
TALKINGBOATS_AIS_SERIAL_BAUD=115200
TALKINGBOATS_AIS_SERIAL_INIT_SEQ=co2,v
TALKINGBOATS_AIS_SERIAL_AUTO_INCLUDE_GPIO=false
TALKINGBOATS_AIS_SERIAL_AUTO_PORTS=
TALKINGBOATS_AIS_SDR_SERIAL=replace-after-ais-catcher-list
TALKINGBOATS_AIS_DEVICE_INDEX=1
TALKINGBOATS_AIS_WEB_PORT=8100
TALKINGBOATS_AIS_COMMUNITY_FEED=anonymous
TALKINGBOATS_AIS_SHARING_KEY=
TALKINGBOATS_AIS_STATION_NAME=Elliott Bay VHF
TALKINGBOATS_AIS_STATION_LINK=https://seattleboatradio.com
TALKINGBOATS_AIS_LAT=47.6190158
TALKINGBOATS_AIS_LON=-122.3595353
TALKINGBOATS_AIS_SHARE_LOC=on
TALKINGBOATS_AIS_FRIENDS_HOST=ais.aisfriends.com
TALKINGBOATS_AIS_FRIENDS_UDP_PORT=
TALKINGBOATS_AIS_HTTP_INGEST_URL=
TALKINGBOATS_AIS_INGEST_TOKEN=
TALKINGBOATS_AIS_FORWARDER_HOST=127.0.0.1
TALKINGBOATS_AIS_FORWARDER_PORT=8110
TALKINGBOATS_AIS_HTTP_INTERVAL_SECONDS=1

# Must exceed the capture service's daily restart so quiet channels remain
# attached to Icecast until systemd refreshes the capture process.
TALKINGBOATS_ICECAST_SOURCE_TIMEOUT_SECONDS=90000

# Set these only after OpenTofu has created the public-site bucket and the Pi has
# AWS credentials with write access to the live/ prefix.
TALKINGBOATS_CLOUD_HLS_ENABLED=false
TALKINGBOATS_PUBLIC_SITE_BUCKET=
TALKINGBOATS_CLOUD_HLS_DIR=/opt/talkingboats/hls
TALKINGBOATS_CLOUD_HLS_S3_PREFIX=live
TALKINGBOATS_CLOUD_HLS_SEGMENT_SECONDS=2
TALKINGBOATS_CLOUD_HLS_LIST_SIZE=6
TALKINGBOATS_CLOUD_HLS_PUBLISH_INTERVAL_SECONDS=1
