TALKINGBOATS_PRIVATE_API=http://optiplex.local:8034
TALKINGBOATS_INGEST_TOKEN=replace-with-private-pi-ingest-token

# Used by talkingboats-upload-clip when a capture loop hands it a completed file.
# The uploader keeps AWS credentials off the Pi by requesting short-lived upload
# URLs from the private API.
TALKINGBOATS_VOICE_DEVICE_INDEX=0
TALKINGBOATS_VOICE_SDR_SERIAL=replace-after-rtl-test
TALKINGBOATS_AIS_SDR_SERIAL=replace-after-ais-catcher-list
TALKINGBOATS_AIS_DEVICE_INDEX=1
TALKINGBOATS_AIS_WEB_PORT=8100
TALKINGBOATS_AIS_COMMUNITY_FEED=anonymous
TALKINGBOATS_AIS_SHARING_KEY=
TALKINGBOATS_AIS_STATION_NAME=Elliott Bay VHF
TALKINGBOATS_AIS_STATION_LINK=https://robertboscacci.com
TALKINGBOATS_AIS_LAT=47.6190158
TALKINGBOATS_AIS_LON=-122.3595353
TALKINGBOATS_AIS_SHARE_LOC=on
TALKINGBOATS_AIS_FRIENDS_HOST=ais.aisfriends.com
TALKINGBOATS_AIS_FRIENDS_UDP_PORT=
