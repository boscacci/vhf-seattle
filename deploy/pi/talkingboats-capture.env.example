TALKINGBOATS_PRIVATE_API=http://optiplex.local:8034
TALKINGBOATS_INGEST_TOKEN=replace-with-private-pi-ingest-token

# Used by talkingboats-upload-clip when a capture loop hands it a completed file.
# The uploader keeps AWS credentials off the Pi by requesting short-lived upload
# URLs from the private API.
TALKINGBOATS_VOICE_SDR_SERIAL=replace-after-rtl-test
TALKINGBOATS_AIS_SDR_SERIAL=replace-after-rtl-test
