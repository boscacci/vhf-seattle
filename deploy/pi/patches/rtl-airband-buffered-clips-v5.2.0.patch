+static bool output_file_ready(channel_t* channel, output_t* output);
+
+static bool encode_split_batch(output_t* output, const std::vector<float>& samples) {
+    file_data* fdata = (file_data*)(output->data);
+    if (!fdata || !fdata->f || samples.size() != WAVE_BATCH) {
+        return false;
+    }
+    int mp3_bytes = lame_encode_buffer_ieee_float(
+        output->lame,
+        samples.data(),
+        NULL,
+        WAVE_BATCH,
+        output->lamebuf,
+        LAMEBUF_SIZE);
+    if (mp3_bytes < 0) {
+        log(LOG_WARNING, "lame_encode_buffer_ieee_float: %d\n", mp3_bytes);
+        return false;
+    }
+    if (mp3_bytes > 0 &&
+        fwrite(output->lamebuf, 1, (size_t)mp3_bytes, fdata->f) < (size_t)mp3_bytes) {
+        log(LOG_WARNING, "Cannot write buffered transmission to %s (%s)\n",
+            fdata->file_path.c_str(), strerror(errno));
+        return false;
+    }
+    gettimeofday(&fdata->last_write_time, NULL);
+    return true;
+}
+
+static void finish_split_file(output_t* output, bool keep) {
+    file_data* fdata = (file_data*)(output->data);
+    if (!fdata) {
+        return;
+    }
+    std::string completed_path = fdata->file_path;
+    close_file(output);
+    if (!keep && !completed_path.empty()) {
+        unlink(completed_path.c_str());
+        debug_print("discarded short buffered transmission %s\n", completed_path.c_str());
+    }
+    fdata->attack.clear();
+    fdata->active_batches = 0;
+    fdata->trailing_batches = 0;
+    fdata->total_batches = 0;
+}
+
+static bool process_buffered_split_output(channel_t* channel, output_t* output) {
+    file_data* fdata = (file_data*)(output->data);
+    if (!fdata || !fdata->split_on_transmission || output->type != O_FILE) {
+        return false;
+    }
+    const bool signal = channel->axcindicate != NO_SIGNAL;
+    const unsigned int pre_roll_batches =
+        (unsigned int)ceil(fdata->pre_roll_seconds * WAVE_RATE / WAVE_BATCH);
+    const unsigned int post_roll_batches =
+        (unsigned int)ceil(fdata->post_roll_seconds * WAVE_RATE / WAVE_BATCH);
+    const unsigned int maximum_batches =
+        (unsigned int)ceil(fdata->maximum_transmission_seconds * WAVE_RATE / WAVE_BATCH);
+    std::vector<float> batch(
+        channel->waveout_unsquelched,
+        channel->waveout_unsquelched + WAVE_BATCH);
+
+    if (!fdata->f) {
+        if (!signal) {
+            fdata->attack.clear();
+            fdata->pre_roll.push_back(batch);
+            while (fdata->pre_roll.size() > pre_roll_batches) {
+                fdata->pre_roll.pop_front();
+            }
+            return true;
+        }
+        fdata->attack.push_back(batch);
+        if (fdata->attack.size() < fdata->attack_confirmation_batches) {
+            return true;
+        }
+        if (!output_file_ready(channel, output)) {
+            log(LOG_WARNING, "Buffered transmission output disabled\n");
+            output->enabled = false;
+            return true;
+        }
+        for (const std::vector<float>& buffered : fdata->pre_roll) {
+            if (!encode_split_batch(output, buffered)) {
+                finish_split_file(output, false);
+                output->enabled = false;
+                return true;
+            }
+            fdata->total_batches++;
+        }
+        fdata->pre_roll.clear();
+        for (const std::vector<float>& confirmed : fdata->attack) {
+            if (!encode_split_batch(output, confirmed)) {
+                finish_split_file(output, false);
+                output->enabled = false;
+                return true;
+            }
+            fdata->active_batches++;
+            fdata->total_batches++;
+        }
+        fdata->attack.clear();
+        output->active = true;
+        return true;
+    }
+
+    if (!encode_split_batch(output, batch)) {
+        finish_split_file(output, false);
+        output->enabled = false;
+        return true;
+    }
+    fdata->total_batches++;
+    if (signal) {
+        fdata->active_batches++;
+        fdata->trailing_batches = 0;
+    } else {
+        fdata->trailing_batches++;
+    }
+    if (fdata->total_batches >= maximum_batches ||
+        (!signal && fdata->trailing_batches >= post_roll_batches)) {
+        const bool keep = fdata->active_batches >= fdata->minimum_active_batches;
+        finish_split_file(output, keep);
+        output->active = false;
+    }
+    return true;
+}
